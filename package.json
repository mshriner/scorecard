{
  "name": "scorecard",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/load-secrets-for-local-develop.js",
    "start": "ng serve",
    "prebuild": "node scripts/write-build-env.js",
    "prebuild:prod": "node scripts/write-build-env.js",
    "build": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:generated": "prettier --write ./src/app/models/generated",
    "lint": "eslint .",
    "generate-api": "node scripts/generate-api.js && npm run format:generated"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/material": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/service-worker": "^22.1.6",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@observablehq/plot": "^0.6.17",
    "dexie": "^4.4.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@vitest/browser-webdriverio": "^5.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "allowScripts": {
    "@openapitools/openapi-generator-cli@2.41.0": true,
    "edgedriver@6.3.1": true,
    "esbuild@0.28.2": true,
    "geckodriver@6.1.1": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "extract-zip": "^2.0.1"
  }
}
