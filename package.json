{
  "name": "scorecard",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/load-secrets-for-local-develop.js",
    "start": "ng serve",
    "prebuild": "node scripts/write-build-env.js",
    "prebuild:prod": "node scripts/write-build-env.js",
    "build": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:generated": "prettier --write ./src/app/models/generated",
    "lint": "eslint .",
    "generate-api": "node scripts/generate-api.js && npm run format:generated"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/service-worker": "^22.0.1",
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@observablehq/plot": "^0.6.17",
    "dexie": "^4.4.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@vitest/browser-webdriverio": "^4.1.6",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
